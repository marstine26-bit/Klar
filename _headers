# Cloudflare Pages headers config — mirrors netlify.toml's [[headers]] blocks.
# Netlify's TOML header blocks aren't read by Cloudflare Pages, so this file
# carries the same rules over in Cloudflare's path + indented-header format.
# Kept alongside netlify.toml (not replacing it) so Netlify still works if we
# ever need to fall back to it.

/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(self)
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://assets.lemonsqueezy.com https://cdn.jsdelivr.net https://static.cloudflareinsights.com; connect-src 'self' https://*.supabase.co https://api.groq.com https://*.lemonsqueezy.com https://app.posthog.com https://*.crisp.chat https://api.saltedge.com https://api.frankfurter.app https://api.frankfurter.dev; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; frame-src https://*.lemonsqueezy.com; frame-ancestors 'none'

# Always revalidate HTML files, but allow conditional GETs (304s) instead of forcing a full
# re-download every load — no-store previously blocked even ETag-based revalidation, which
# needlessly burned bandwidth-metered Netlify credits on every repeat visit of the 1.2MB app file.
/*.html
  Cache-Control: no-cache, must-revalidate

# Cache static assets aggressively
/icons/*
  Cache-Control: public, max-age=31536000, immutable

/sw.js
  Cache-Control: no-cache, no-store, must-revalidate
